<AdminReassignUserRfidScreen@Screen>:
    AdminPage:
        AdminScreenTitle:
            text: 'Переназначение RFID пользователя'

        AdminScrollBody:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: form_card.height + dp(16)
                size_hint_x: 1
                padding: 0, dp(8)

                AdminCenteredForm:
                    height: form_card.height

                    AdminFormCard:
                        id: form_card
                        width: min(root.width - dp(32), dp(520))
                        height: form_body.minimum_height + dp(48)

                        AdminFormBody:
                            id: form_body

                            AdminFormRow:
                                AdminFieldLabel:
                                    text: 'Пользователь:'
                                AdminSpinner:
                                    id: reassign_user_spinner
                                    text: 'Выберите пользователя'
                                    on_text: app.controller.admin_reassign_user_rfid_on_select(self.text)

                            AdminCaptionLabel:
                                id: reassign_current_rfid
                                text: 'Текущая метка: —'
                                size_hint_y: None
                                height: self.texture_size[1] + dp(4)

                            MDLabel:
                                text: 'Выберите пользователя, нажмите «Ждать RFID» и приложите метку к считывателю.'
                                font_style: 'Body2'
                                theme_text_color: 'Secondary'
                                halign: 'center'
                                text_size: self.width, None
                                size_hint_y: None
                                height: self.texture_size[1] + dp(8)

                            AdminStatusLabel:
                                id: user_rfid_status
                                text: ''
                                halign: 'center'
                                size_hint_y: None
                                height: self.texture_size[1] + dp(8)

                            AdminActionsFooter:
                                AdminFormBackButton:
                                    on_release: app.controller.admin_cancel_user_rfid_bind()
                                AdminFormSubmitButton:
                                    text: 'Ждать RFID'
                                    on_release: app.controller.admin_reassign_user_rfid_arm()
