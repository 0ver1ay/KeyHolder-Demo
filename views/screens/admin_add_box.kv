<AdminAddBoxScreen@Screen>:
    AdminPage:
        AdminScreenTitle:
            text: 'Создать бокс'

        AdminScrollBody:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: form_card.height + dp(16)
                size_hint_x: 1
                padding: 0, dp(8)

                AdminCenteredForm:
                    height: form_card.height

                    AdminFormCard:
                        id: form_card
                        width: min(root.width - dp(32), dp(520))
                        height: form_body.minimum_height + dp(48)

                        AdminFormBody:
                            id: form_body

                            AdminFormRow:
                                AdminFieldLabel:
                                    text: 'Название бокса:'
                                AdminTextField:
                                    id: admin_new_box_name
                                    hint_text: 'Например, Бокс A'
                            AdminFormRow:
                                AdminFieldLabel:
                                    text: 'Комментарий:'
                                AdminTextField:
                                    id: admin_new_box_comment
                                    hint_text: 'Необязательно'
                            AdminFormRow:
                                AdminFieldLabel:
                                    text: 'Столбцов (X):'
                                AdminTextField:
                                    id: admin_new_box_x
                                    hint_text: '6'
                                    input_filter: 'int'
                            AdminFormRow:
                                AdminFieldLabel:
                                    text: 'Строк (Y):'
                                AdminTextField:
                                    id: admin_new_box_y
                                    hint_text: '4'
                                    input_filter: 'int'

                            AdminActionsFooter:
                                AdminFormBackButton:
                                    on_release: app.root.current = 'admin_menu'
                                AdminFormSubmitButton:
                                    text: 'Создать бокс'
                                    on_release: app.controller.admin_create_box(admin_new_box_name.text, admin_new_box_comment.text, admin_new_box_x.text, admin_new_box_y.text)
