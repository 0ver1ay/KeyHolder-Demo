<MismatchScreen@Screen>:
    canvas.before:
        Color:
            rgba: 0.10, 0.11, 0.12, 1  # непрозрачный фон, скрывает базовый экран
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(16)
        padding: dp(24), dp(24), dp(24), dp(24)

        Widget:
            size_hint_y: 0.2

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(12)
            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: None
                height: dp(64)
                MDIcon:
                    icon: 'alert-circle-outline'
                    theme_text_color: 'Custom'
                    text_color: 1, 0.35, 0.35, 1
                    size_hint: None, None
                    size: dp(64), dp(64)
            MDLabel:
                id: mismatch_title
                text: 'Неверная ячейка'
                halign: 'center'
                font_style: 'H5'
                theme_text_color: 'Custom'
                text_color: 1,1,1,1
                size_hint_y: None
                height: self.texture_size[1]
            MDLabel:
                id: mismatch_message
                text: 'Снят/положен ключ в неверную ячейку.\nПожалуйста, выполните действие в указанной ячейке.'
                halign: 'center'
                theme_text_color: 'Secondary'
                size_hint_y: None
                height: self.texture_size[1]
            MDLabel:
                id: mismatch_hint
                text: 'Экран закроется автоматически по корректному действию или по таймауту.'
                halign: 'center'
                theme_text_color: 'Secondary'
                size_hint_y: None
                height: self.texture_size[1]

        Widget:
            size_hint_y: 0.6


