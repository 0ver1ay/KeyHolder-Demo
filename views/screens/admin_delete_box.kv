<AdminDeleteBoxScreen@Screen>:
    AdminPage:
        AdminScreenTitle:
            text: 'Удалить бокс'

        AdminScrollBody:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: form_card.height + dp(16)
                size_hint_x: 1
                padding: 0, dp(8)

                AdminCenteredForm:
                    height: form_card.height

                    AdminFormCard:
                        id: form_card
                        width: min(root.width - dp(32), dp(520))
                        height: form_body.minimum_height + dp(48)

                        AdminFormBody:
                            id: form_body

                            AdminFormRow:
                                AdminFieldLabel:
                                    text: 'Бокс:'
                                AdminSpinner:
                                    id: del_box_spinner
                                    text: 'Выберите бокс'
                                    on_kv_post: app.controller._populate_delete_box_spinner()

                            AdminActionsFooter:
                                AdminFormBackButton:
                                    on_release: app.root.current = 'admin_menu'
                                AdminFormDangerButton:
                                    text: 'Удалить бокс'
                                    on_release: app.controller.admin_delete_box_request(del_box_spinner.text)
