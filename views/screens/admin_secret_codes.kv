<AdminSecretCodesScreen@Screen>:
    AdminPage:
        AdminScreenTitle:
            text: 'Секретные коды для сдачи ключей'

        AdminScreenSubtitle:
            text: 'Код позволяет сдать ключ без RFID-допуска'

        AdminScrollBody:
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: form_card.height + dp(16)
                size_hint_x: 1
                padding: 0, dp(8)

                AdminCenteredForm:
                    height: form_card.height

                    AdminFormCard:
                        id: form_card
                        width: min(root.width - dp(32), dp(520))
                        height: form_body.minimum_height + dp(48)

                        AdminFormBody:
                            id: form_body

                            AdminFormRow:
                                AdminFieldLabel:
                                    text: 'Ключ:'
                                AdminSpinner:
                                    id: sc_key_spinner
                                    text: 'Выберите ключ'
                                    on_text: app.controller.admin_secret_code_key_selected(self.text)
                            AdminFormRow:
                                AdminFieldLabel:
                                    text: 'Секретный код:'
                                AdminTextField:
                                    id: sc_code_input
                                    hint_text: 'Необязательно'
                                    password: True

                            AdminActionsFooter:
                                AdminFormBackButton:
                                    on_release: app.root.current = 'admin_menu'
                                AdminFormSubmitButton:
                                    text: 'Сохранить'
                                    on_release: app.controller.admin_save_secret_code(sc_key_spinner.text, sc_code_input.text)
