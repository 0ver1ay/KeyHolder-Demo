<AdminAssignBoxScreen@Screen>:
    AdminPage:
        AdminScreenTitle:
            text: 'Назначить ключи на бокс'

        PermissionsCard:
            size_hint: 1, 1

            BoxLayout:
                orientation: 'vertical'
                spacing: dp(12)

                AdminFormRow:
                    AdminFieldLabel:
                        text: 'Бокс:'
                    AdminSpinner:
                        id: assign_box_spinner
                        text: 'Выберите бокс'
                        on_kv_post: app.controller._populate_assign_box_spinner()
                        on_text: app.controller.admin_assign_on_box_selected(self.text)

                AdminCaptionLabel:
                    id: assign_capacity_label
                    text: ''

                AdminScrollPanel:
                    AnchorLayout:
                        size_hint: None, None
                        anchor_x: 'center'
                        anchor_y: 'top'
                        width: assign_keys_grid.minimum_width
                        height: max(assign_keys_grid.minimum_height, dp(120))

                        GridLayout:
                            id: assign_keys_grid
                            cols: 3
                            spacing: dp(16)
                            padding: dp(8), dp(4)
                            size_hint: None, None
                            size: self.minimum_size
                            on_kv_post: app.controller.admin_assign_refresh_keys_grid()

                AdminActionsFooter:
                    AdminFormBackButton:
                        on_release: app.root.current = 'admin_menu'
                    AdminFormSubmitButton:
                        text: 'Обновить'
                        on_release: app.controller.admin_assign_refresh_keys_grid()
                    AdminPager:
                        AdminPagerButton:
                            text: '<'
                            on_release: app.controller.admin_assign_prev_page()
                        AdminPageLabel:
                            id: assign_page_label
                        AdminPagerButton:
                            text: '>'
                            on_release: app.controller.admin_assign_next_page()
