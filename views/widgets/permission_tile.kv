<PermissionTile>:
    # Data
    room_name: ''
    key_code: ''
    allowed: False
    # Appearance
    size_hint: None, None
    width: dp(260)
    height: dp(120)
    radius: [12]
    elevation: 4
    md_bg_color: 1, 1, 1, 0.96
    padding: dp(16)

    # Toggle permission on click anywhere on the tile (admin only)
    on_release: app.controller.on_admin_switch(self, not self.allowed) if root.allow_toggle else None

    BoxLayout:
        orientation: 'horizontal'
        spacing: dp(12)

        AnchorLayout:
            anchor_x: 'left'
            anchor_y: 'center'
            size_hint_x: 1
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(2)
                size_hint_y: None
                height: self.minimum_height
                MDLabel:
                    text: root.room_name if root.room_name else ''
                    font_style: 'Body1'
                    theme_text_color: 'Custom'
                    text_color: 0.06, 0.06, 0.07, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None
                    shorten: True
                    shorten_from: 'right'
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    text: root.label_assigned if root.allowed else root.label_unassigned
                    font_style: 'Caption'
                    theme_text_color: 'Custom'
                    text_color: 0.45, 0.47, 0.50, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None
                    shorten: True
                    shorten_from: 'right'
                    size_hint_y: None
                    height: self.texture_size[1]

        AnchorLayout:
            size_hint: None, None
            size: dp(40), dp(40)
            pos_hint: {'center_y': 0.5}
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0.96
                Ellipse:
                    pos: self.pos
                    size: self.size
            MDIcon:
                icon: 'check' if root.allowed else 'close'
                theme_text_color: 'Custom'
                text_color: (0.25, 0.75, 0.35, 1) if root.allowed else (1, 0.25, 0.25, 1)
                size_hint: None, None
                size: dp(22), dp(22)
                pos_hint: {'center_y': 0.5}


