<BaseSemiFlatButton@Button>:
    size_hint_y: None
    height: dp(48)
    background_normal: ''
    background_down: ''
    background_color: 0.22, 0.24, 0.28, 1
    color: 0, 0, 0, 1
    font_size: sp(16)
    padding: dp(16), 0
    canvas.before:
        Color:
            rgba: (self.background_color[0] * (0.92 if self.state == 'down' else 1), self.background_color[1] * (0.92 if self.state == 'down' else 1), self.background_color[2] * (0.92 if self.state == 'down' else 1), self.background_color[3])
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12, 12, 12, 12]

<PrimaryButton@BaseSemiFlatButton>:
    background_color: 0.28, 0.48, 0.92, 1
    color: 1, 1, 1, 1

<SecondaryButton@BaseSemiFlatButton>:
    # Darker neutral for secondary actions
    background_color: 0.13, 0.15, 0.17, 1
    color: 0.92, 0.92, 0.92, 1

# Optional: subtle outline variant
<OutlinedButton@BaseSemiFlatButton>:
    background_color: 0.1, 0.11, 0.12, 1
    color: 0.85, 0.88, 0.9, 1
    canvas.before:
        Color:
            rgba: (self.background_color[0], self.background_color[1], self.background_color[2], self.background_color[3])
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12, 12, 12, 12]
        Color:
            rgba: 1, 1, 1, 0.06
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
            width: 1


# iOS-inspired (Cupertino) buttons
# - Rounded 14px corners, soft shadow, pressed state lowers opacity and shifts slightly
# - Filled (blue) and Outline (gray) variants tuned for dark theme
<IOSFilledButton@HoverBehavior+Button>:
    size_hint_y: None
    height: dp(46)
    background_normal: ''
    background_down: ''
    # iOS blue
    background_color: 0.12, 0.47, 1, 1
    # Text style
    font_size: sp(14)
    color: 0, 0, 0, 1
    padding: dp(20), 0
    canvas.before:
        Color:
            rgba: (0, 0, 0, 0.35 if self.state == 'normal' else 0.20)
        RoundedRectangle:
            pos: self.x, self.y - dp(2)
            size: self.width, dp(8)
            radius: [12, 12, 12, 12]
        Color:
            rgba: (self.background_color[0] * (0.92 if self.state == 'down' else 1), self.background_color[1] * (0.92 if self.state == 'down' else 1), self.background_color[2] * (0.92 if self.state == 'down' else 1), 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14, 14, 14, 14]
    # removed canvas.after overlay to ensure text is fully visible

<IOSOutlineButton@HoverBehavior+Button>:
    size_hint_y: None
    height: dp(46)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    # Text style
    font_size: sp(14)
    color: 0, 0, 0, 1
    padding: dp(20), 0
    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.06)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14, 14, 14, 14]
        Color:
            rgba: (1, 1, 1, 0.18 if self.state == 'normal' else 0.10)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 14)
            width: 1
    # removed canvas.after overlay to ensure text is fully visible

<IOSGrayButton@HoverBehavior+Button>:
    size_hint_y: None
    height: dp(46)
    background_normal: ''
    background_down: ''
    # Text style
    font_size: sp(14)
    color: 0, 0, 0, 1
    padding: dp(20), 0
    # lighter neutral base to match brighter theme
    background_color: 0.40, 0.42, 0.45, 1
    # mimic elevation by offset shadow and slight lift; press lowers it
    canvas.before:
        Color:
            rgba: (0, 0, 0, (0.55 if (self.hovered and self.state == 'normal') else (0.45 if self.state == 'normal' else 0.25)))
        RoundedRectangle:
            pos: self.x + dp(1), self.y - ((dp(5) if (self.hovered and self.state == 'normal') else (dp(4) if self.state == 'normal' else dp(2))))
            size: self.width - dp(2), dp(10)
            radius: [12, 12, 12, 12]
        # Clip inner content to rounded corners
        StencilPush
        RoundedRectangle:
            pos: self.x, self.y + (0 if self.state == 'down' else dp(1))
            size: self.size
            radius: [14, 14, 14, 14]
        StencilUse
        # gradient surface via texture for smooth shading, respecting radius
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            texture: self.grad_tex if hasattr(self, 'grad_tex') else None
            pos: self.x, self.y + (0 if self.state == 'down' else dp(1))
            size: self.size
            radius: [14, 14, 14, 14]
        # lateral soft shadows to suggest horizontal depth (clipped)
        Color:
            rgba: (0, 0, 0, 0.20 if self.state == 'normal' else 0.12)
        RoundedRectangle:
            pos: self.x - dp(1), self.y + dp(4)
            size: dp(3), self.height - dp(8)
            radius: [12, 0, 0, 12]
        RoundedRectangle:
            pos: self.right - dp(2), self.y + dp(4)
            size: dp(3), self.height - dp(8)
            radius: [0, 12, 12, 0]
        StencilUnUse
        StencilPop
    # removed canvas.after overlay to ensure text is fully visible

<DangerButton@BaseSemiFlatButton>:
    background_color: 0.62, 0.22, 0.22, 1
    color: 1, 1, 1, 1

# Subtle footer button styled similar to big tiles but less accent
# Крупнее под тачскрин: высокая кнопка и заметный шрифт
<FooterButton@MDCard>:
    text: ''
    font_size: sp(20)
    on_release: None
    size_hint: 1, None
    height: dp(64)
    radius: [14]
    elevation: 4
    md_bg_color: 0.14, 0.15, 0.17, 1
    ripple_behavior: True
    padding: dp(16)
    BoxLayout:
        orientation: 'vertical'
        padding: 0, 0
        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            MDLabel:
                text: root.text
                font_style: 'Body1'
                font_size: root.font_size
                bold: True
                theme_text_color: 'Custom'
                text_color: 0.92, 0.93, 0.95, 1
                halign: 'center'
                valign: 'middle'
                text_size: self.size

# Серые тестовые кнопки (нижняя панель UserApp)
<TestGrayButton@FooterButton>:
    md_bg_color: 0.38, 0.39, 0.41, 1
    height: dp(64)
