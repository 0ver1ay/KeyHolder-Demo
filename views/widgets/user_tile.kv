<UserKeyTile@MDCard>:
    # Data
    room_name: ''
    key_code: ''
    status_text: ''   # first line
    sub_status_text: ''  # second line
    # Appearance
    size_hint: None, None
    width: dp(260)
    height: dp(140)
    radius: [16]
    elevation: 6
    md_bg_color: 1, 1, 1, 0.96
    padding: dp(16)
    ripple_behavior: True

    # User action: issue/return key via controller
    on_release: app.controller.on_key_placeholder_press(self)

    BoxLayout:
        orientation: 'horizontal'
        spacing: dp(12)

        AnchorLayout:
            anchor_x: 'left'
            anchor_y: 'center'
            size_hint_x: 1
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(4)
                size_hint_y: None
                height: self.minimum_height
                MDLabel:
                    text: root.room_name if root.room_name else ''
                    font_style: 'Body1'
                    theme_text_color: 'Custom'
                    text_color: (1, 1, 1, 1) if (hasattr(root, 'md_bg_color') and root.md_bg_color[1] < 0.5) else (0.06, 0.06, 0.07, 1)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None
                    shorten: True
                    shorten_from: 'right'
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    text: root.status_text if root.status_text else ''
                    font_style: 'Caption'
                    theme_text_color: 'Custom'
                    text_color: (0.95, 0.95, 0.98, 1) if (hasattr(root, 'md_bg_color') and root.md_bg_color[1] < 0.5) else (0.45, 0.47, 0.50, 1)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None
                    shorten: False
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    text: root.sub_status_text if root.sub_status_text else ''
                    font_style: 'Caption'
                    theme_text_color: 'Custom'
                    text_color: (0.95, 0.95, 0.98, 1) if (hasattr(root, 'md_bg_color') and root.md_bg_color[1] < 0.5) else (0.45, 0.47, 0.50, 1)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None
                    shorten: False
                    size_hint_y: None
                    height: self.texture_size[1]

        AnchorLayout:
            size_hint: None, None
            size: dp(44), dp(44)
            pos_hint: {'center_y': 0.5}
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0.96
                Ellipse:
                    pos: self.pos
                    size: self.size
            MDIcon:
                id: status_icon
                # icon by exact status
                icon: 'key' if (root.status_text.startswith('выдан') if hasattr(root.status_text, 'startswith') else False) or root.status_text == 'ключ выдан' else ('check' if root.status_text in ('допуск есть', 'ключ сдан', 'Ключ сдан') else 'close')
                theme_text_color: 'Custom'
                text_color: (0.10, 0.40, 1.0, 1) if (root.status_text.startswith('выдан') if hasattr(root.status_text, 'startswith') else False) or root.status_text == 'ключ выдан' else ((0.25, 0.75, 0.35, 1) if root.status_text in ('допуск есть', 'ключ сдан', 'Ключ сдан') else (1, 0.25, 0.25, 1))
                size_hint: None, None
                size: dp(24), dp(24)
                pos_hint: {'center_y': 0.5}


